par Roaming.host.wlan typename "\"inet.linklayer.ieee80211.Ieee80211Interface\""
par Roaming.host.wlan displayStringTextFormat "\"%a (%i)\\n%m\""
attr mutable ""
par Roaming.host.wlan recordPcap false
par Roaming.host.wlan numPcapRecorders 0
par Roaming.host.wlan interfaceTableModule "\"^.interfaceTable\""
par Roaming.host.wlan energySourceModule "\"\""
par Roaming.host.wlan opMode "\"a\""
attr enum a,b,g(erp),g(mixed),n(mixed-2.4Ghz),p,ac
par Roaming.host.wlan address "\"0A-AA-00-00-00-01\""
attr mutable ""
par Roaming.host.wlan protocol "\"\""
par Roaming.host.wlan bitrate 1.2e+07bps
attr unit bps
scalar Roaming.host.wlan packetDropInterfaceDown:count 0
attr interpolationmode none
attr recordingmode count
attr source packetDropReasonIsInterfaceDown(packetDropped)
attr title "packet drops: interface down, count"
scalar Roaming.host.wlan packetDropInterfaceDown:sum(packetBytes) 0
attr interpolationmode none
attr recordingmode sum(packetBytes)
attr source packetDropReasonIsInterfaceDown(packetDropped)
attr title "packet drops: interface down, sum(packetBytes)"
scalar Roaming.host.wlan packetDropNoCarrier:count 0
attr interpolationmode none
attr recordingmode count
attr source packetDropReasonIsNoCarrier(packetDropped)
attr title "packet drops: no carrier, count"
scalar Roaming.host.wlan packetDropNoCarrier:sum(packetBytes) 0
attr interpolationmode none
attr recordingmode sum(packetBytes)
attr source packetDropReasonIsNoCarrier(packetDropped)
attr title "packet drops: no carrier, sum(packetBytes)"
par Roaming.host.interfaceTable typename "\"inet.networklayer.common.InterfaceTable\""
par Roaming.host.interfaceTable displayStringTextFormat "\"{numInterfaces} interfaces\""
attr mutable ""
par Roaming.host.interfaceTable displayAddresses false
par Roaming.host.mobility typename "\"inet.mobility.single.TurtleMobility\""
par Roaming.host.mobility displayStringTextFormat "\"p: {position}\\nv: {velocity}\""
attr mutable ""
par Roaming.host.mobility subjectModule "\"^\""
par Roaming.host.mobility coordinateSystemModule "\"\""
par Roaming.host.mobility updateDisplayString true
par Roaming.host.mobility constraintAreaMinX 0m
attr unit m
par Roaming.host.mobility constraintAreaMinY 0m
attr unit m
par Roaming.host.mobility constraintAreaMinZ 0m
attr unit m
par Roaming.host.mobility constraintAreaMaxX 600m
attr unit m
par Roaming.host.mobility constraintAreaMaxY 200m
attr unit m
par Roaming.host.mobility constraintAreaMaxZ 0m
attr unit m
par Roaming.host.mobility updateInterval 0.1s
attr unit s
par Roaming.host.mobility faceForward true
par Roaming.host.mobility turtleScript "xml('<movement>\\n  <set angle=\"0\" speed=\"1.5\" x=\"50\" y=\"102\"/>\\n  <forward d=\"51\"/>\\n</movement>\\n')"
par Roaming.host typename "\"phase3.MobileStation\""
par Roaming typename "\"phase3.Roaming\""
par Roaming D 51m
attr unit m
par Roaming survey false

