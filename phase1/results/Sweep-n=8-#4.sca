version 3
run Sweep-24-20261125-15:20:40-9636
attr configname Sweep
attr datetime 20261125-15:20:40
attr datetimef 20261125-152040
attr experiment Sweep
attr inifile omnetpp.ini
attr iterationvars $n=8
attr iterationvarsd n=8
attr iterationvarsf n=8-
attr measurement $n=8
attr network Contention
attr processid 9636
attr repetition 4
attr replication #4
attr resultdir results
attr runnumber 24
attr seedset 24
itervar n 8
config image-path ../../inet/images
config description "n saturated stations; model-vs-simulation sweep"
config repeat 5
config *.n 8
config cmdenv-express-mode true
config record-eventlog false
config network Contention
config Contention.**.wlan*.bitrate 18Mbps
config Contention.**.cli.reqLength 950B
config Anomaly.n 6
config Anomaly.host[0].wlan[*].bitrate 9Mbps
config Anomaly.host[*].wlan[*].bitrate 48Mbps
config Anomaly.ap.wlan[*].bitrate 48Mbps
config Anomaly.**.messageLength 950B
config Anomaly.ap.**.pendingQueue.numQueues 6
config Roaming.D 51m
config Roaming.radioMedium.pathLoss.alpha 3.2
config Roaming.radioMedium.pathLoss.sigma 4
config Roaming.ap*.wlan.mgmt.beaconInterval 200ms
config Roaming.host.wlan.mgmt.numChannels 5
config Roaming.*.mobility.turtleScript "xml(\"<movement><set x='50' y='102' speed='1.5' angle='0'/><forward d='51'/></movement>\")"
config sim-time-limit 12s
config warmup-period 2s
config **.vector-recording false
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 400m
config **.constraintAreaMaxY 400m
config **.constraintAreaMaxZ 0m
config *.radioMedium.sameTransmissionStartTimeCheck "\"ignore\""
config **.wlan*.opMode "\"a\""
config **.wlan*.radio.bandName "\"5 GHz (20 MHz)\""
config **.wlan*.radio.channelNumber 8
config **.radio.transmitter.power 20mW
config **.fragmentationPolicy.fragmentationThreshold 2346B
config **.ap.wlan.address "\"10:00:00:00:00:00\""
config **.mgmt.accessPointAddress "\"10:00:00:00:00:00\""
config **.cli.respLength 0B
config **.cli.destAddress "\"20:00:00:00:00:00\""
config **.cli.sendInterval 50us
config *.ap.mobility.initialX 200m
config *.ap.mobility.initialY 200m
config **.mobility.initialZ 0m
config **.mobility.initFromDisplayString false

